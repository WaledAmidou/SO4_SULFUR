%% ============================================================
% HELPER FUNCTIONS
%% ============================================================

function col_index = find_match(vars, target_names)
    % Find matching column index from list of target names
    col_index = 0;
    for i = 1:length(vars)
        for j = 1:length(target_names)
            if strcmpi(vars{i}, target_names{j})
                col_index = i;
                return;
            end
        end
    end
end
